import numpy as np
from numpy import sin,cos

x0, y0, z0 = 1263889.1166544738, -4882952.864373464, 3890894.1186579103 #initial ECEF meters
initial_ECEF = np.array([x0,y0,z0])

#WGS84 parameters
a = 6378137.0
f = 1 / 298.57223563
b = a * (1-f)
e2 = 1 - (b/a) ** 2
ep2 = (a**2 - b**2) / b**2

#longitude
lam = np.arctan2(y0,x0)

#geodetic Latitude
p = np.sqrt(x0**2 + y0**2)
theta = np.arctan2(z0*a, p*b)
phi = np.arctan2(z0 + ep2*b*np.sin(theta)**3,
                 p - e2*a*np.cos(theta)**3)

#up vector
up_ECEF = np.array([np.cos(phi)*np.cos(lam), np.cos(phi)*np.sin(lam), np.sin(phi)])

class dynamics:
    def __init__(self):
        self.m = 1
        
        self.simTimeStep = 0.001
        self.a_max = 20 * 9.81

        self.state = np.array([[z0,0]]).T
        self.linear_state = np.array([[z0,0]]).T
        self.jerk_state = np.array([[z0,0,0]]).T

    def f(self,state,u):
        z = state.item(0)
        zDot = state.item(1)
        F = u.item(0)
        zDDot = F/self.m
        xDot = np.array([[zDot, zDDot]]).T
        return xDot

    def jerk_f(self,state,u):
        z = state.item(0)
        zDot = state.item(1)
        zDDot = state.item(2)
        F = u.item(0)
        zDDDot = F
        xDot = np.array([[zDot, zDDot, zDDDot]]).T
        return xDot

    def update(self,u, linear_u, jerk_u):
        self.state = self.gen_rk4_step(u,self.f,self.state)
        self.linear_state = self.gen_rk4_step(linear_u,self.f,self.state)
        self.jerk_state = self.gen_rk4_step(jerk_u,self.jerk_f,self.jerk_state)

    def gen_rk4_step(self,u,f,state):
        F1 = f(state,u)
        F2 = f(state + self.simTimeStep/2*F1,u)
        F3 = f(state + self.simTimeStep/2*F2,u)
        F4 = f(state + self.simTimeStep*F3,u)
        state = state + self.simTimeStep/6 * (F1+2*F2+2*F3+F4)
        return state

    def acceleration_profile(self, t):
        if 0 <= t < 30:
            return self.a_max*t/30
        elif 30 <= t < 60:
            return self.a_max * (60-t) / 30
        else:
            return 0

    def linear_profile(self,t):
        if 0 <= 60:
            return self.a_max*t/60
        else:
            return 0

    def jerk_profile(self, t):
        if 0 <= t < 8:
            return t*0.75
        elif 8 <= t <= 15:
            return 0
        elif 15 <= t < 20:
            return (-t+15)*1.4
        elif 20 <= t < 25:
            return 0
        elif 25 <= t < 30:
            return (t-25)*1.6
        elif 30 <= t < 35:
            return 0
        elif 35 <= t < 40:
            return (-t+35)*1.8
        elif 40 <= t < 45:
            return 0
        elif 45 <= t < 50:
            return (t-45)*2.0
        elif 50 <= t < 55:
            return 0
        elif 55 <= t < 60:
            return (-t+55)*2.2
        else:
            return 0


t_start = -30
TALO = -120
t_end = 60
t_step = 0.01
frames = int((t_end - t_start) / t_step)
state_array = np.zeros((frames, 18), dtype='object')
linear_state_array = np.zeros((frames, 18), dtype='object')
jerk_state_array = np.zeros((frames, 18), dtype='object')
time_array = np.zeros(frames, dtype='float')
D = dynamics()

t = t_start
for i in range(frames):
    F = np.array([[D.acceleration_profile(t)]])
    F_linear = np.array([[D.linear_profile(t)]])
    F_jerk = np.array([[D.jerk_profile(t)]]) * 11/29 * 9.81

    D.update(F,F_linear,F_jerk)

    total_ms = round(t*1000)
    hours, remainder = divmod(total_ms, 3600000)
    minutes, remainder = divmod(remainder, 60000)
    seconds, ms = divmod(remainder, 1000)
    timestamp = f"0 {hours:02d}:{minutes:02d}:{seconds:02d}.{ms:03d}"

    #reframe
    z = D.state.item(0)
    zDot = D.state.item(1)
    zDDot = F.item(0)
    linear_z = D.linear_state.item(0)
    linear_zDot = D.linear_state.item(1)
    linear_zDDot = F_linear.item(0)
    jerk_z = D.jerk_state.item(0)
    jerk_zDot = D.jerk_state.item(1)
    jerk_zDDot = D.jerk_state.item(2)
    jerk_zDDDot = F_jerk.item(0)

    pos_ecef = initial_ECEF + (z- z0)*up_ECEF 
    vel_ecef = zDot*up_ECEF
    accel_ecef = zDDot * up_ECEF

    linear_pos_ecef = initial_ECEF + (linear_z- z0)*up_ECEF 
    linear_vel_ecef = linear_zDot*up_ECEF
    linear_accel_ecef = linear_zDDot * up_ECEF

    jerk_pos_ecef = initial_ECEF + (jerk_z-z0)*up_ECEF
    jerk_vel_ecef = zDot*up_ECEF
    jerk_accel_ecef = jerk_zDDot*up_ECEF
    jerk_jerk_ecef = jerk_zDDDot*up_ECEF


    #logging
    state_array[i,:] = np.array([[timestamp,'mot','v1_m1', *pos_ecef, *vel_ecef, *accel_ecef, 0, 0, 0, 0, 0, 0]])
    linear_state_array[i,:] = np.array([[timestamp,'mot','v1_m1', *linear_pos_ecef, *linear_vel_ecef, *linear_accel_ecef, 0, 0, 0, 0, 0, 0]])
    jerk_state_array[i,:] = np.array([[timestamp,'mot','v1_m1', *jerk_pos_ecef, *jerk_vel_ecef, *jerk_accel_ecef, *jerk_jerk_ecef, 0, 0, 0]])
    time_array[i] = t
    
    t = t+t_step - t_start
    TALO = TALO + t_step
